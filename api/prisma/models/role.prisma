enum RoleType {
  STUDENT
  TUTOR
  DEPARTMENT_HEAD
  SUPER_ADMIN
}

enum RoleStatus {
  ACTIVE
  INACTIVE
}

model Role {
  id        Int        @id @default(autoincrement())
  title     String     @unique
  type      RoleType   @unique
  status    RoleStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  users User[]

  @@map("roles")
}