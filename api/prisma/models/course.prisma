model Course {
  id          Int       @id @default(autoincrement())
  title       String    @unique
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @map("updated_at")

  enrollments Enrollment[]
  liveClasses LiveClass[]

  @@map("courses")
}
