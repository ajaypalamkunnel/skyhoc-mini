enum AttendanceStatus {
  PRESENT
  ABSENT
}

model AttendanceRecord {
  id                   Int              @id @default(autoincrement())
  liveClassId          Int              @map("live_class_id")
  userId               Int              @map("user_id")
  totalMinutes         Int              @map("total_minutes")
  attendancePercentage Decimal          @db.Decimal(5, 2) @map("attendance_percentage")
  status               AttendanceStatus
  calculatedAt         DateTime         @map("calculated_at")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  liveClass LiveClass @relation(fields: [liveClassId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, liveClassId])
  @@index([userId])
  @@index([liveClassId])
  @@index([status])
  @@map("attendance_records")
}